{
  "name": "immi-arash-amir",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "triggers": {"crons": ["0 * * * *", "*/15 * * * *", "*/5 * * * *", "2-57/5 * * * *", "15 */6 * * *"]},
  "vars": {
    "GOOGLE_REDIRECT_URI": "https://immi-arash-amir.dr-gerami-md.workers.dev/api/google/callback"
  },
  "d1_databases": [{
    "binding": "GOOGLE_DB",
    "database_name": "immi-google-private",
    "database_id": "faf37526-9c8c-4a86-9f91-3ab41ee8ddff"
  },{
    "binding": "OPPORTUNITY_DB",
    "database_name": "immi-opportunities",
    "database_id": "a9605bec-79b7-430d-8d15-cfacb4cb1a58"
  }],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {"enabled": false}
}
