{
  "name": "immi-arash-amir",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {"enabled": false}
}
